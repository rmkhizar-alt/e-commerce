# Copy this file to .env and fill in your real values. Never commit .env.

PORT=4000

# Where the contact form messages get delivered to
TO_EMAIL=rmkhizar@gmail.com

# The Gmail account that SENDS the email (can be the same as TO_EMAIL,
# or a separate sender account like a "noreply" mailbox you own).
# EMAIL_PASS must be a 16-character Gmail "App Password", NOT your normal
# Gmail login password. See README.md for how to generate one.
EMAIL_USER=your_sender_address@gmail.com
EMAIL_PASS=your_16_char_app_password

# Only needed if you want to use a non-Gmail SMTP provider instead
# (e.g. Outlook, Zoho, SendGrid SMTP). Leave blank to use Gmail.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
